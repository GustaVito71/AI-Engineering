# Copia este archivo a .env y pega tus API keys:  cp .env.example .env
# NUNCA subas tu .env real a git: sus valores son secretos. Ya está en .gitignore.
#
# Variables de lidr_3 y lidr_4 que acá ya no están: LLM_PROVIDER, PRIMARY_MODEL y
# FALLBACK_MODEL. El proveedor del servicio y el del respaldo se eligen con
# LLM_DEFAULT y LLM_FALLBACK, y el modelo de cada proveedor sale de su variable
# <PROVEEDOR>_MODEL. El failover lo hace el Router de LiteLLM.
#
# --- API keys. Vacías = el servicio arranca igual y /health lo reporta como
# llm_configured: false. Se exigen en el punto de uso, no al arrancar:
# - Sin la clave del proveedor de LLM_DEFAULT (abajo, OPENAI_API_KEY) no hay
#   estimaciones: POST /api/v1/estimate responde 503 nombrando la variable.
# - Sin la de LLM_FALLBACK (abajo, ANTHROPIC_API_KEY) se estima solo con el
#   primario, y se avisa en el log, en /health y en `warnings` de cada respuesta.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Gemini y DeepSeek son del extractor de project_metadata (Paso 4). Sin GEMINI_API_KEY
# el servicio estima igual, pero la memoria del proyecto no se actualiza y cada
# respuesta lo avisa en `warnings`.
GEMINI_API_KEY=
DEEPSEEK_API_KEY=

# Sentry (todavía no se usa en el código)
SENTRY_DSN=

# Búsqueda web (servicios independientes del proveedor del modelo). Cada servicio
# tiene su propia cuenta y clave. Sin ninguna clave, la herramienta de búsqueda no se registra.
WEB_TAVILY_KEY=
WEB_FIRECRAWL_KEY=

# --- Qué servicio de búsqueda es el principal y cuál el respaldo.
# Tienen que ser DISTINTOS y uno de: tavily, firecrawl.
SEARCH_DEFAULT=tavily
SEARCH_FALLBACK=firecrawl
# Paso 11. La búsqueda solo funciona con AGENT_LOOP_ENABLED=true (ver más abajo).
# SEARCH_MAX_PER_TURN: tope de búsquedas por petición. SEARCH_MAX_SNIPPET_CHARS: texto máximo
# por resultado. SEARCH_TIMEOUT_SECONDS: espera máxima a cada servicio. SEARCH_LOG_QUERIES=true
# registra el texto de la consulta (truncado a 80 caracteres); apagado, solo su largo.
SEARCH_MAX_PER_TURN=2
SEARCH_MAX_SNIPPET_CHARS=1500
SEARCH_TIMEOUT_SECONDS=15
SEARCH_LOG_QUERIES=false

# --- Router: dos deployments, uno por proveedor. LLM_DEFAULT es el camino
# normal; LLM_FALLBACK atiende si el primario falla (rate limit, timeout, 5xx)
# después de agotar los reintentos. Tienen que ser DISTINTOS, si no el arranque
# falla. Hoy los proveedores soportados son openai y anthropic.
LLM_DEFAULT=openai
LLM_FALLBACK=anthropic

# Modelo de cada proveedor (el servicio arma "proveedor/modelo" para LiteLLM).
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-5-5

# --- Extractor de project_metadata (primario y respaldo). Tienen que ser DISTINTOS.
# Proveedores válidos: openai, anthropic, gemini y deepseek.
EXTRACTOR_DEFAULT=gemini
EXTRACTOR_FALLBACK=deepseek
GEMINI_MODEL=gemini-3.1-flash-lite
DEEPSEEK_MODEL=deepseek-flash

# --- Sesiones conversacionales (POST /sessions/{id}/estimate).
# CONVERSATION_PROMPT_VERSION: versión del prompt (de salida estructurada). v5 es la que
# inyecta la memoria del proyecto. DEFAULT_TIER: audiencia del bloque <audience> de v5
# (executive, pm, developer o default; default no agrega nada).
CONVERSATION_PROMPT_VERSION=v5
DEFAULT_TIER=default

# Robustez y coste. El timeout evita que una llamada colgada retenga un worker
# una hora; LLM_MAX_RETRIES son los reintentos antes de pasar al respaldo.
# LLM_MAX_TOKENS sube respecto de lidr_3 porque la salida estructurada de WU8
# es más larga que el markdown equivalente, y un tope corto produce JSON
# truncado a mitad de stream.
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4000

# --- Capa 2: qué versión de la plantilla se usa (prompts/estimation/vN/).
#
# Hoy la caché es exact-match y su clave incluye el prompt completo, así que
# cambiar la plantilla ya la invalida sola. Con el caché semántico de WU10 eso
# deja de ser cierto: la clave embebe solo la consulta del usuario, y si
# cambiás la plantilla sin bumpear esto, el caché seguiría sirviendo
# estimaciones de la versión vieja sin avisar. Es el mecanismo de invalidación.
#
# Versiones: v1 responde en inglés; v2 es la misma estimación en castellano
# (instrucciones, ejemplos y formato de números).
#
# Regla: las plantillas publicadas son inmutables. Un bug en v1 se corrige
# sacando v2, nunca editando v1.
PROMPT_VERSION=v2

# --- Structured response ----------------------------------------------------
# Versión de prompt por defecto de POST /api/v1/estimate/structured. Tiene que
# ser de salida estructurada (`output: structured` en su examples.yaml); una
# versión de texto o inexistente hace que ese endpoint responda 503 nombrando
# esta variable. PROMPT_VERSION sigue siendo la de /estimate.
STRUCTURED_PROMPT_VERSION=v3
# Cuántas veces se vuelve a preguntar al modelo si su respuesta no cumple el
# schema. Cada reintento es una llamada completa que se paga. Independiente de
# LLM_MAX_RETRIES, que reintenta los fallos del proveedor.
STRUCTURED_MAX_RETRIES=2

# --- Rendered response ------------------------------------------------------
# Versión de prompt por defecto de POST /api/v1/estimate/rendered: salida
# estructurada más la presentación (tabla, partidas o narrativa, según
# output_format) escrita por el modelo. Tiene que ser de salida renderizada
# (`output: rendered` en su examples.yaml); si no, ese endpoint responde 503
# nombrando esta variable. Usa los reintentos de STRUCTURED_MAX_RETRIES.
RENDERED_PROMPT_VERSION=v4

# --- Caché. REDIS_URL vacío = caché desactivada, sin tocar código. Si Redis no
# está o no responde, el servicio sigue funcionando sin caché (fail soft): no
# hace falta tener Redis corriendo para desarrollar. En Docker este valor no se
# usa: docker-compose.yml lo fija en redis://redis:6379/0.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400

# --- Caché semántica (WU10). Encendida por defecto: devuelve la estimación de OTRA
# descripción parecida, y eso lo decide el operador. Solo actúa en /estimate/structured
# y /estimate/rendered. Necesita Redis y la clave del proveedor del modelo de embeddings
# (OPENAI_API_KEY); sin alguno de los dos queda apagada con un aviso en el log.
# Recomendado: encender primero con SEMANTIC_CACHE_LOG_ONLY=true, mirar las similitudes
# del log (evento cache_semantica_solo_log) y ajustar el umbral antes de servir aciertos.
SEMANTIC_CACHE_ENABLED=true
# Similitud coseno mínima, en (0, 1]. Cuanto más alto, más estricta la coincidencia:
# 0.95 (medido con test/calibrar_cache.py) solo acepta paráfrasis muy cercanas; a 0.92
# «con pagos» y «sin pagos» ya acertaban entre sí, y 0.85 arriesga devolver una estimación
# de otro proyecto.
CACHE_SEMANTIC_THRESHOLD=0.95
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_TIMEOUT=3.0
SEMANTIC_CACHE_LOG_ONLY=false
# Entradas por espacio de búsqueda (modelo, versión, parámetros). La similitud se calcula
# en la app: el coste de cada búsqueda crece con este número.
SEMANTIC_CACHE_MAX_ENTRIES=200

# --- Input guardrails -------------------------------------------------------
# Reglas que corren sobre la descripción antes de armar el prompt y de la caché
# (app/guardrails/input.py): inyección de prompt (rechaza, 422), datos
# personales (los oculta y avisa) y moderación de OpenAI (rechaza, 422).
# GUARDRAILS_ENABLED=false las apaga todas; sirve para medir, no para producción.
GUARDRAILS_ENABLED=true
# La moderación de OpenAI no se cobra, pero necesita OPENAI_API_KEY: sin clave
# queda apagada (y se avisa una vez en el log) y el resto de las reglas sigue.
# Falla abierta: si no responde en MODERATION_TIMEOUT segundos, la descripción sigue.
MODERATION_ENABLED=true
MODERATION_MODEL=omni-moderation-latest
MODERATION_TIMEOUT=3.0

# --- Techo del operador sobre `description`. El contrato 20/2000 vive en el
# Field de app/schemas/estimation.py y no se configura. Estos dos valores solo
# pueden RESTRINGIR ese rango: ponerlos más laxos rompe el contrato y la app
# falla al arrancar. Restringirlo es deliberado (recorta casos de uso y baja el
# coste máximo por request). Los otros tres campos son enums y no necesitan techo.
# Antes se llamaban DESCRIPCION_MIN_CHARS y DESCRIPCION_MAX_CHARS; esos nombres
# se siguen leyendo, pero si están los dos manda el nuevo.
DESCRIPTION_MIN_CHARS=20
DESCRIPTION_MAX_CHARS=2000

# --- Frontend. URL base del API para Streamlit (cliente HTTP separado). En
# Docker este valor no se usa: docker-compose.yml lo fija en http://api:8001.
# Streamlit corre en el puerto 8002 (la API en el 8001).
ESTIMATOR_API_BASE_URL=http://localhost:8001

APP_ENV=development
# Nivel de los logs propios del servicio (INFO por defecto). Las librerías
# HTTP, el SDK y LiteLLM quedan fijas en WARNING (aunque se defina LITELLM_LOG)
# para no volcar headers con identificadores de cuenta ni los mensajes de cada
# llamada. Ningún nivel escribe el prompt ni la respuesta del
# modelo en el log: los eventos de trazabilidad llevan solo métricas.
LOG_LEVEL=INFO

# Puerto del servidor (el 8000 lo suele tener tomado Docker: default 8001).
APP_PORT=8001

# --- Output guardrails ------------------------------------------------------
# Lo que se comprueba de la salida (app/guardrails/output.py): descarta la respuesta
# con datos personales o el prompt volcado (502) y avisa de totales que no cuadran,
# confianza baja y fuera de alcance. Las reglas que
# rechazan y re-preguntan viven en el schema y no dependen de este interruptor.
# OUTPUT_GUARDRAILS_ENABLED=false apaga todo esto, no las reglas del schema.
OUTPUT_GUARDRAILS_ENABLED=true
# Una confianza global por debajo de este valor (0-100) añade un aviso.
# 0 lo desactiva. El umbral de rechazo del schema (30 %) es aparte.
LOW_CONFIDENCE_WARN_PCT=70

# --- Sesiones conversacionales. Turnos (pares usuario + asistente) que conserva la
# ventana deslizante del historial de cada sesión. Mínimo 1; vacío = 6.
MAX_TURNS=6
# Segundos sin uso tras los cuales una sesión caduca (vacío = 86400, 24 h) y tope de
# sesiones vivas a la vez (vacío = 1000; al llenarse se descarta la menos usada).
SESSION_TTL_SECONDS=86400
MAX_SESSIONS=1000

# --- ACB (Actor-Crítico-Jefe). Máximo de vueltas actor + crítico por petición a
# /sessions/{id}/estimate-acb; cada vuelta son dos llamadas al LLM. Mínimo 1; vacío = 3.
BOSS_MAX_ITERATIONS=3

# --- Bucle agéntico y presupuesto de tokens (Paso 10). AGENT_LOOP_ENABLED=true enciende el
# bucle en el que el modelo pide herramientas; sin herramientas registradas (llegan en los
# Pasos 11 y 12) no hace nada. AGENT_MAX_ITERATIONS: tope de rondas modelo->herramientas por
# turno (mínimo 1; vacío = 4). TURN_TOKEN_BUDGET: techo de tokens del contexto de un turno
# (transcripción, historial, adjuntos y resultados de herramientas; mínimo 1.000; vacío = 60000).
AGENT_LOOP_ENABLED=false
AGENT_MAX_ITERATIONS=4
TURN_TOKEN_BUDGET=60000

# --- Compresión del historial (Paso 9). Cómo se detectan los turnos con compromisos
# (alcance cerrado, presupuesto fijo, NDA...) que se conservan textuales al salir de la
# ventana: `heuristic` (expresiones regulares, sin coste) o `llm` (una llamada barata por
# turno que sale, más robusta ante paráfrasis; usa el proveedor del extractor). Vacío = heuristic.
ANCHOR_DETECTION_MODE=heuristic

# --- Backend de negocio (Paso 12). El servicio IA no conoce el esquema del negocio: solo
# la URL y la clave. En este repo, business_backend/ es un simulado (ver su README en
# business_backend/docker-compose.snippet.yml para el bloque de docker-compose).
BUSINESS_API_URL=
BUSINESS_API_KEY=
BUSINESS_MAX_PER_TURN=2
BUSINESS_TIMEOUT_SECONDS=5
