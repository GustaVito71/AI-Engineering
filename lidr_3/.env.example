# Copia este archivo a .env y pega tu API key:  cp .env.example .env
# NUNCA subas tu .env real a git: sus valores son secretos. Ya está en .gitignore.

# Deja al menos una key según el proveedor que uses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor por defecto: "openai" o "anthropic"
LLM_PROVIDER=openai

# Modelo (opcional). Vacío = se resuelve según el proveedor:
#   openai -> OPENAI_MODEL | anthropic -> ANTHROPIC_MODEL (default aquí)
LLM_MODEL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Robustez y coste. El timeout evita que una llamada colgada retenga un worker
# una hora (el default del SDK es 600 s y reintenta 2 veces).
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000

# Fallback: proveedor alterno si el primario falla (rate limit, timeout, 5xx).
# Vacío = fallback desactivado. Debe ser "openai" o "anthropic" y DISTINTO de LLM_PROVIDER.
LLM_FALLBACK=anthropic

# Cache Redis: URL de conexión y TTL en segundos (24h por defecto).
# REDIS_URL vacío = cache DESACTIVADO, sin tocar código: el servicio sigue
# funcionando, solo que cada request genera de nuevo. Es el modo por defecto
# en desarrollo, donde no hay Redis corriendo.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400

# URL base del API para Streamlit (cliente HTTP separado del backend).
ESTIMATOR_API_BASE_URL=http://localhost:8001

# Techo de la entrada del usuario: el tamaño de la entrada es la factura.
ESTIMATION_MIN_CHARS=50
ESTIMATION_MAX_CHARS=50000

APP_ENV=development
# INFO es el default. Con DEBUG se emite `contenido_intento`, que vuelca el
# prompt completo y la respuesta completa del modelo al log: sirve para
# depurar en local, no para una transcripción de cliente.
LOG_LEVEL=INFO

# Puerto del servidor (el 8000 lo suele tener tomado Docker: default 8001).
APP_PORT=8001
