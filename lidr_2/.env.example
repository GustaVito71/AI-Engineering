# Copia este archivo a .env y pega tu API key:  cp .env.example .env
# NUNCA subas tu .env real a git: sus valores son secretos. Ya está en .gitignore.

# Deja al menos una key según el proveedor que uses.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Proveedor por defecto: "openai" o "anthropic"
LLM_PROVIDER=openai

# Modelo (opcional). Vacío = se resuelve según el proveedor:
#   openai -> OPENAI_MODEL | anthropic -> ANTHROPIC_MODEL (default aquí)
LLM_MODEL=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_MODEL=claude-haiku-4-5

# Robustez y coste. El timeout evita que una llamada colgada retenga un worker
# una hora (el default del SDK es 600 s y reintenta 2 veces).
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=2000

# Techo de la entrada del usuario: el tamaño de la entrada es la factura.
ESTIMATION_MIN_CHARS=50
ESTIMATION_MAX_CHARS=50000

APP_ENV=
LOG_LEVEL=

# Puerto del servidor (el 8000 lo suele tener tomado Docker: default 8001).
APP_PORT=8001
