# Copia este archivo a .env y pega tus API keys:  cp .env.example .env
# NUNCA subas tu .env real a git: sus valores son secretos. Ya está en .gitignore.
#
# Variables que lidr_3 tenía y acá ya no: LLM_PROVIDER y LLM_FALLBACK. No hay
# switch de proveedor ni fallback propio; el Router de LiteLLM se encarga. Y
# el provider se deduce del prefijo del modelo ("openai/..."), no al revés.

# --- API keys. Vacías = el servicio arranca igual y /health lo reporta como
# llm_configured: false. Se exigen en el punto de uso, no al arrancar: hacen
# falta las claves de los proveedores de PRIMARY_MODEL y de FALLBACK_MODEL
# (con los valores de abajo, las dos). Si falta alguna, POST /api/v1/estimate
# responde 503 nombrando la variable.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# --- Router: dos deployments, uno por modelo. El primario es el camino
# normal; el de respaldo atiende si el primario falla (rate limit, timeout,
# 5xx) después de agotar los reintentos. Tienen que ser DISTINTOS, si no el
# arranque falla.
#
# El prefijo antes de "/" es el provider y decide qué API key usa el
# deployment. Hoy solo hay claves para openai y anthropic.
#
# LLM_MODEL_GROUP se lee pero todavía no se usa: cada deployment se nombra con
# su propio modelo.
LLM_MODEL_GROUP=estimator
PRIMARY_MODEL=openai/gpt-4o-mini
FALLBACK_MODEL=anthropic/claude-haiku-4-5

# Robustez y coste. El timeout evita que una llamada colgada retenga un worker
# una hora; LLM_MAX_RETRIES son los reintentos antes de pasar al respaldo.
# LLM_MAX_TOKENS sube respecto de lidr_3 porque la salida estructurada de WU8
# es más larga que el markdown equivalente, y un tope corto produce JSON
# truncado a mitad de stream.
LLM_TIMEOUT=30.0
LLM_MAX_RETRIES=2
LLM_MAX_TOKENS=4000

# --- Capa 2: qué versión de la plantilla se usa (prompts/estimation/vN/).
#
# Hoy la caché es exact-match y su clave incluye el prompt completo, así que
# cambiar la plantilla ya la invalida sola. Con el caché semántico de WU10 eso
# deja de ser cierto: la clave embebe solo la consulta del usuario, y si
# cambiás la plantilla sin bumpear esto, el caché seguiría sirviendo
# estimaciones de la versión vieja sin avisar. Es el mecanismo de invalidación.
#
# Regla: las plantillas publicadas son inmutables. Un bug en v1 se corrige
# sacando v2, nunca editando v1.
PROMPT_VERSION=v1

# --- Caché. REDIS_URL vacío = caché desactivada, sin tocar código. Si Redis no
# está o no responde, el servicio sigue funcionando sin caché (fail soft): no
# hace falta tener Redis corriendo para desarrollar.
REDIS_URL=redis://localhost:6379/0
CACHE_TTL=86400

# Umbral de similitud del caché semántico, en [0,1]. Cuanto más alto, más
# estricta la coincidencia: 0.95 solo acepta paráfrasis muy cercanas, 0.85
# arriesga devolver una estimación de otro proyecto. Lo define WU10; hoy está
# comentado para no anunciar una variable que el código todavía no lee.
# CACHE_SEMANTIC_THRESHOLD=0.92

# --- Techo del operador sobre `description`. El contrato 20/2000 vive en el
# Field de app/schemas/estimation.py y no se configura. Estos dos valores solo
# pueden RESTRINGIR ese rango: ponerlos más laxos rompe el contrato y la app
# falla al arrancar. Restringirlo es deliberado (recorta casos de uso y baja el
# coste máximo por request). Los otros tres campos son enums y no necesitan techo.
DESCRIPCION_MIN_CHARS=20
DESCRIPCION_MAX_CHARS=2000

# --- Frontend. URL base del API para Streamlit (cliente HTTP separado).
ESTIMATOR_API_BASE_URL=http://localhost:8001

APP_ENV=development
# Nivel de los logs propios del servicio (INFO por defecto). Las librerías
# HTTP y del SDK quedan fijas en WARNING para no volcar headers con
# identificadores de cuenta. Ningún nivel escribe el prompt ni la respuesta del
# modelo en el log: los eventos de trazabilidad llevan solo métricas.
LOG_LEVEL=INFO

# Puerto del servidor (el 8000 lo suele tener tomado Docker: default 8001).
APP_PORT=8001
